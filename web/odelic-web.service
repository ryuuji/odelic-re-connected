[Unit]
Description=ODELIC lighting web UI (settings page and phone UI)
Documentation=https://github.com/ryuuji/odelic-re-connected
# odelicd に照明操作を投げ、ブリッジの管理 API で器具名と Matter を読み書きする。
# ⭐ どちらも落ちていても起動する（照明の操作は odelicd さえ生きていればできる）
After=network-online.target odelicd.service odelic-matter.service
Wants=odelicd.service

[Service]
Type=simple
EnvironmentFile=-/etc/default/odelic-web
WorkingDirectory=/opt/odelic-web
ExecStart=/usr/bin/node /opt/odelic-web/dist/src/main.js --config /etc/odelic-web/config.json

User=odelic-web
Group=odelic-web
# ⭐ ログ画面のために journal を読む。sudo は使わない（sudo で許すのは set-id.sh だけ）
SupplementaryGroups=systemd-journal

# パスワードのハッシュとセッションの置き場。⚠️ 0700
StateDirectory=odelic-web
StateDirectoryMode=0700

# ⚠️⚠️ NoNewPrivileges を true にしてはいけない。
#    true にすると `sudo /opt/odelic-web/set-id.sh` が動かず、
#    メッシュ ID の設定画面が「権限がありません」で死ぬ（原因が分かりにくい）。
#    ⭐ 代わりに sudoers で **set-id.sh 1 本だけ**を許可し、そのスクリプト側で
#       argv を 8 桁の数字 / --rollback / --status に厳格に絞っている。
NoNewPrivileges=no

Restart=always
RestartSec=5

# ⚠️ Pi 3 は RAM 1 GB。odelicd（31 MB）を OOM の犠牲にしないため上限を付け、
#    死ぬ順番も odelicd → ブリッジ(200) → Web(300) になるようにする
MemoryMax=192M
OOMScoreAdjust=300

# BLE も raw HCI も使わない
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

# ⚠️⚠️ **sudo は名前空間を抜けられない。**
#    `ProtectSystem=strict` は全体を読み取り専用でマウントするので、
#    **sudo で root になった特権ヘルパーにも効く。**ここに挙げないと
#    「公開範囲の切り替え」「ホーム ID の変更」「バックアップの復元」が
#      mktemp: failed to create file via template
#      '/etc/default/.odelicd.XXXXXX': Read-only file system
#    で失敗する（実際に踏んだ）。⚠️ root なのに EROFS なので原因が分かりにくい。
#
# ⭐ **守っているのは名前空間ではなく DAC のほう。** 下記はどれも
#    odelic-web(uid 997) からは書けない:
#      /etc/default /etc/odelic-web … root:root 0755（作成できるのは root だけ）
#      /etc/odelic-matter           … odelic-matter 所有
#      /var/lib/odelicd             … root:root 0700
#      /var/lib/odelic-matter       … odelic-matter 0700（読むこともできない）
#    → ここを書き換えられるのは **sudoers で許した 3 本のヘルパーだけ**。
#    ⚠️ だからこの行を足しても設定ページ本体にできることは増えない。
#
# ⚠️ `/etc/odelic-web`（ローカル CA の鍵）は以前 ReadOnlyPaths に入れていたが、
#    バックアップの復元がここへ書くので外した。上のとおり DAC で守られている。
ReadWritePaths=/etc/default /etc/odelic-matter /etc/odelic-web /var/lib/odelicd /var/lib/odelic-matter
# ⚠️ AF_NETLINK が要る（Node の os.networkInterfaces() が使う）
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
